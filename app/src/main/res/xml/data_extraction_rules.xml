<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: no cloud backup and no device-to-device transfer. allowBackup="false"
     alone does not stop the transfer on every manufacturer's phones (Android 12 behaviour change),
     and a transferred layout would only be half-wiped by the first start on the new phone, where
     most apps are still queued for installation. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
