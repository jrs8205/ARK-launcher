    <string name="dream_brightness_title">Egen ljusstyrka</string>
    <string name="dream_brightness_description">Skärmsläckaren använder ljusstyrkan som ställs in nedan, i alla stilar, i stället för att följa telefonens. Gäller inte medan skärmsläckaren är dämpad.</string>
    <string name="dream_brightness_hint">Medan du drar reglaget visas den här sidan med den valda ljusstyrkan.</string>
    <string name="dream_calendar_title">Visa kalender</string>
    <string name="dream_calendar_description">Upp till tre kommande händelser i stilen Mätare. Kräver behörighet att läsa kalendern.</string>
